{
    "name": "comanage/dynamo-provisioner",
    "description": "DynamoProvisioner plugin for COmanage Registry",
    "type": "cakephp-plugin",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^4.4",
        "aws/aws-sdk-php": "^3.303"
    },
    "autoload": {
        "psr-4": {
            "DynamoProvisioner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DynamoProvisioner\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "vendor-dir": "vendor"
    }
}
